---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceTile from '../components/ServiceTile.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import ContactFull from '../components/ContactFull.astro';
import { services } from '../data/site';
import { caseStudies } from '../data/caseStudies';
import { portfolioItems } from '../data/portfolio';
---

<Base>
  <main>
    <div class="wrap hero-block gradient-mesh">
      <Hero />
      <div class="hero-links">
        <a class="hero-link primary" href="#portfolio">View My Work</a>
        <a class="hero-link secondary" href="/pricing">See Pricing</a>
      </div>
    </div>

    <section class="wrap services">
      {services.map((service) => <ServiceTile service={service} />)}
    </section>

    <section class="wrap about">
      <img
        class="about-img"
        src="/about/about-osiris.webp"
        alt="About Osiris — social media manager and content creator with 5+ years in social media, strategy, shooting and editing, powered by iced lattes. OC based, working with small businesses. Cancer baby."
        width="1600"
        height="878"
      />
    </section>

    <section id="portfolio" class="wrap portfolio">
      <div class="portfolio-head">
        <span class="eyebrow">Portfolio</span>
        <h2>From idea → camera roll → your feed</h2>
        <p>Real shoots, scroll-stopping content, and creative ideas brought to life.</p>
      </div>

      <div class="case-studies">
        {caseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>

      <div class="more-work">
        <span class="eyebrow">Beyond the Feed</span>
        <div class="grid">
          {
            portfolioItems.map((item, i) => (
              <PortfolioCard item={item} shape={i === 0 ? 'circle' : 'square'} />
            ))
          }
        </div>
      </div>
    </section>

    <div class="wrap">
      <ContactFull />
    </div>
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    padding: 64px 24px 96px;
  }

  .hero-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    padding: 64px 40px;
  }

  .hero-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-link {
    padding: 15px 28px;
    border-radius: 999px;
    text-align: center;
    font-size: 16px;
    font-weight: 800;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .hero-link.primary {
    border: 2px solid var(--blue);
    background: var(--blue);
    color: var(--cream);
  }

  .hero-link.primary:hover {
    background: var(--blue-dark);
    border-color: var(--blue-dark);
  }

  .hero-link.secondary {
    border: 2px solid var(--peach);
    background: transparent;
    color: var(--peach-muted);
  }

  .hero-link.secondary:hover {
    background: var(--peach);
    color: var(--peach-ink);
  }

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
  }

  .about-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .portfolio {
    display: flex;
    flex-direction: column;
    gap: 44px;
    scroll-margin-top: 90px;
  }

  .portfolio-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tint);
  }

  .portfolio-head h2 {
    font-family: var(--display);
    font-size: 34px;
    font-weight: 800;
    color: var(--cream);
    -webkit-text-stroke: 2.5px var(--blue-dark);
    paint-order: stroke fill;
    letter-spacing: 0.01em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .portfolio-head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    font-weight: 600;
    color: var(--muted);
    max-width: 620px;
  }

  .case-studies {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .more-work {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 900px) {
    .portfolio-head h2 {
      white-space: normal;
      font-size: 30px;
      -webkit-text-stroke-width: 2px;
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 16px;
    }
  }
</style>
