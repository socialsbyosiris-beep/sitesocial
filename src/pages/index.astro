---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceTile from '../components/ServiceTile.astro';
import ContactFull from '../components/ContactFull.astro';
import { services } from '../data/site';
---

<Base>
  <main>
    <div class="hero-block">
      <Hero />
      <div class="hero-links">
        <a class="hero-link primary" href="/pricing">See Pricing</a>
        <a class="hero-link" href="/portfolio">View Portfolio</a>
      </div>
    </div>

    <section class="wrap services">
      {services.map((service) => <ServiceTile service={service} />)}
    </section>

    <div class="wrap">
      <ContactFull />
    </div>
  </main>
</Base>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 72px;
    padding: 64px 24px 96px;
  }

  .hero-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .hero-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-link {
    padding: 15px 28px;
    border: 2px solid var(--blue);
    border-radius: 999px;
    font-size: 16px;
    font-weight: 800;
    color: var(--blue);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .hero-link:hover {
    background: var(--blue);
    color: var(--cream);
  }

  .hero-link.primary {
    background: var(--blue);
    color: var(--cream);
  }

  .hero-link.primary:hover {
    background: var(--blue-dark);
    border-color: var(--blue-dark);
  }

  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 20px;
  }
</style>
