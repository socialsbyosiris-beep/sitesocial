---
import { about } from '../data/about';
---

<section class="about wrap">
  <a href="#portfolio" class="about-link" aria-label="See my work below">
    <img src={about.image} alt={about.alt} class="about-image" />
  </a>
</section>

<style>
  .about {
    display: flex;
    justify-content: center;
  }

  .about-link {
    display: block;
  }

  .about-image {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    border-radius: 24px;
  }
</style>
