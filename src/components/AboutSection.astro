---
import { about } from '../data/about';
import type { AboutFact } from '../data/about';
---

<section class="about wrap">
  <span class="line line-top outline-title">About</span>

  <div class="row">
    <ul class="facts left">
      {
        about.factsLeft.map((fact: AboutFact) => (
          <li>
            {fact.icon === 'camera' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="3" />
                <path d="M8 7l1.6-3h4.8L16 7" />
                <circle cx="12" cy="14" r="4" />
              </svg>
            )}
            {fact.icon === 'drink' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 9h10l-1 11.2a2 2 0 01-2 1.8h-4a2 2 0 01-2-1.8L7 9z" />
                <path d="M6 9h12" />
                <path d="M14.5 5l1 4" />
              </svg>
            )}
            <span>{fact.text}</span>
          </li>
        ))
      }
    </ul>

    <div class="photo-frame">
      <div class="blob" />
      {
        about.photo ? (
          <img src={about.photo} alt="Osiris" class="photo" />
        ) : (
          <div class="photo-placeholder">O</div>
        )
      }
    </div>

    <ul class="facts right">
      {
        about.factsRight.map((fact: AboutFact) => (
          <li>
            {fact.icon === 'heart' && (
              <svg viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M12 21s-7.5-4.6-10-9.1C0.5 8.7 2 5 5.5 5c2 0 3.3 1.1 4 2.2 0.7-1.1 2-2.2 4-2.2 3.5 0 5 3.7 3.5 6.9-2.5 4.5-10 9.1-10 9.1z" />
              </svg>
            )}
            {fact.icon === 'controller' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 8h12a4 4 0 014 4c0 3-1.5 6-3.5 6-1.2 0-1.8-1-2.7-2H9.2c-0.9 1-1.5 2-2.7 2C4.5 18 3 15 3 12a4 4 0 013-4z" />
                <path d="M8 11.5v3M6.5 13h3" />
                <circle cx="16" cy="10.5" r="0.9" fill="currentColor" stroke="none" />
                <circle cx="18.2" cy="12.7" r="0.9" fill="currentColor" stroke="none" />
              </svg>
            )}
            <span>{fact.text}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <span class="line line-bottom outline-title">Osiris</span>

  <p class="closing">{about.closing}</p>

  <a class="scroll-cue" href="#portfolio">
    <span>See my work below</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v16M6 14l6 6 6-6" />
    </svg>
  </a>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .line {
    text-align: center;
    letter-spacing: 0.02em;
  }

  .line-top {
    font-size: 64px;
    -webkit-text-stroke-width: 3px;
    -webkit-text-stroke-color: var(--blue);
  }

  .line-bottom {
    font-size: 64px;
    -webkit-text-stroke-width: 3px;
    -webkit-text-stroke-color: var(--peach);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
    width: 100%;
    max-width: 900px;
    margin: 8px 0;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .facts.left {
    align-items: flex-end;
    text-align: right;
  }

  .facts.left li {
    flex-direction: row-reverse;
  }

  .facts.right {
    align-items: flex-start;
    text-align: left;
  }

  .facts svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--blue);
  }

  .photo-frame {
    position: relative;
    width: 220px;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blob {
    position: absolute;
    inset: 0;
    background: var(--sand);
    border-radius: 46% 54% 58% 42% / 48% 42% 58% 52%;
    transform: scale(1.08) rotate(-4deg);
  }

  .photo,
  .photo-placeholder {
    position: relative;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    border: 4px solid var(--card);
    box-shadow: 0 12px 28px rgba(70, 115, 144, 0.18);
    object-fit: cover;
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
    font-family: var(--display);
    font-size: 64px;
    font-weight: 800;
    color: var(--cream);
  }

  .closing {
    margin: 10px 0 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--muted);
    text-align: center;
  }

  .scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tint);
  }

  .scroll-cue:hover {
    color: var(--blue);
  }

  .scroll-cue svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 720px) {
    .line-top,
    .line-bottom {
      font-size: 40px;
      -webkit-text-stroke-width: 2px;
    }

    .row {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 20px;
    }

    .facts.left,
    .facts.right {
      align-items: center;
      text-align: center;
    }

    .facts.left li {
      flex-direction: row;
    }

    .photo-frame {
      order: -1;
      width: 180px;
      height: 180px;
    }

    .photo,
    .photo-placeholder {
      width: 150px;
      height: 150px;
    }
  }
</style>
