---
import type { CaseStudy } from '../data/caseStudies';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<article class="case">
  <div class="top">
    <div class="photo-grid">
      {
        study.photos.map((photo) =>
          'src' in photo ? (
            <img
              class="photo"
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              style={photo.position ? `object-position: ${photo.position}` : undefined}
            />
          ) : (
            <span class={`photo tone-${photo.tone}`} />
          )
        )
      }
    </div>
    <div class="goals">
      <span class="eyebrow">The Goals</span>
      <ul>
        {study.goals.map((goal) => <li>{goal}</li>)}
      </ul>
    </div>
  </div>

  <a class="brand" href={study.instagramHref}>
    <span class="brand-label">Brand:</span> {study.brand}
    <span class="handle">{study.instagramHandle}</span>
  </a>

  {study.intro.map((paragraph) => <p class="intro">{paragraph}</p>)}

  <div class="skills-tools">
    <div class="skills">
      <span class="eyebrow">What I Brought</span>
      <div class="pills">
        {study.skills.map((skill) => <span class="pill">{skill}</span>)}
      </div>
    </div>
    <div class="tools">
      <span class="eyebrow">Tools &amp; Platforms</span>
      <div class="tool-list">
        {
          study.tools.map((tool) => (
            <div class="tool">
              <span class="tool-name">{tool.name}</span>
              <span class="tool-blurb">{tool.blurb}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="tasks-results">
    <div class="tasks">
      <h3>What I Did</h3>
      {
        study.tasks.map((task) => (
          <div class="task">
            <div class="task-head">
              <span class="task-number">{task.number}</span>
              <h4>{task.title}</h4>
            </div>
            <p>{task.body}</p>
            {task.columns && (
              <div class="task-columns">
                {task.columns.map((col) => (
                  <div class="task-col">
                    <span class="col-label">{col.label}</span>
                    <p>{col.text}</p>
                  </div>
                ))}
              </div>
            )}
            {task.palette && (
              <div class="palette">
                {task.palette.map((hex) => <span class="swatch" style={`background:${hex}`} />)}
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="results">
      <h3>The Results</h3>
      <div class="results-block">
        <h4 class="results-title">{study.results.title}</h4>
        <p class="results-copy">{study.results.description}</p>
        <div class="stat-list">
          {
            study.results.stats.map((stat) => (
              <div class="stat">
                <span class="stat-value">{stat.value}</span>
                <div class="stat-text">
                  <span class="stat-label">{stat.label}</span>
                  {stat.sub && <span class="stat-sub">{stat.sub}</span>}
                </div>
              </div>
            ))
          }
        </div>
        <p class="results-note">{study.results.note}</p>
      </div>
    </div>
  </div>
</article>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: var(--card);
    border: 2px solid var(--sand-line);
    border-radius: 30px;
    padding: 32px;
  }

  .top {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 32px;
    align-items: center;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    object-fit: cover;
  }

  .goals {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 340px;
    margin-left: auto;
  }

  .goals .eyebrow {
    font-family: var(--display);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--cream);
    -webkit-text-stroke: 2.5px var(--blue);
    paint-order: stroke fill;
    line-height: 1.1;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tint);
  }

  .goals ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .goals li {
    font-size: 17px;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ink-soft);
    padding-left: 22px;
    position: relative;
  }

  .goals li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--sage-dark);
    font-weight: 800;
  }

  .brand {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .brand-label {
    color: var(--tint);
    text-transform: uppercase;
  }

  .handle {
    margin-left: 6px;
    color: var(--muted-lighter);
    font-weight: 700;
  }

  .brand:hover {
    color: var(--blue);
  }

  .intro {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 720px;
  }

  .skills-tools {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    padding-top: 24px;
    border-top: 2px dashed var(--dash);
  }

  .skills,
  .tools {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--sand);
    font-size: 13px;
    font-weight: 800;
    color: var(--ink);
  }

  .tool-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tool {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .tool-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--blue);
  }

  .tool-blurb {
    font-size: 13px;
    color: var(--muted);
  }

  .tasks-results {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 32px;
    align-items: start;
    padding-top: 24px;
    border-top: 2px dashed var(--dash);
  }

  .tasks {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tasks h3 {
    margin-bottom: 8px;
    font-family: var(--display);
    font-size: 40px;
    font-weight: 800;
    color: var(--cream);
    -webkit-text-stroke: 2.5px var(--blue);
    paint-order: stroke fill;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .task {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .task-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .task-number {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 800;
    color: var(--peach-muted);
  }

  .task-head h4 {
    font-family: var(--display);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
  }

  .task p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 640px;
  }

  .task-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 6px;
  }

  .col-label {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tint);
  }

  .task-col p {
    font-size: 13.5px;
  }

  .palette {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }

  .swatch {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--card);
    box-shadow: 0 0 0 2px var(--sand-line);
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .results h3 {
    font-family: var(--display);
    font-size: 40px;
    font-weight: 800;
    color: var(--cream);
    -webkit-text-stroke: 2.5px var(--blue);
    paint-order: stroke fill;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .results-block {
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: var(--blue-dark);
    border-radius: 24px;
    padding: 28px;
  }

  .results-title {
    margin: 0;
    font-family: var(--display);
    font-size: 24px;
    font-weight: 800;
    color: var(--cream);
  }

  .results-copy {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--on-blue-soft);
  }

  .stat-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 4px;
  }

  .stat {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .stat-value {
    flex-shrink: 0;
    font-family: var(--display);
    font-size: 38px;
    font-weight: 800;
    color: var(--cream);
    -webkit-text-stroke: 2px var(--peach);
    paint-order: stroke fill;
    white-space: nowrap;
  }

  .stat-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .stat-label {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--on-blue);
  }

  .stat-sub {
    font-size: 12.5px;
    color: var(--on-blue-dim);
  }

  .results-note {
    margin: 0;
    padding-top: 14px;
    border-top: 2px dashed rgba(255, 253, 251, 0.25);
    font-size: 12px;
    font-style: italic;
    color: var(--on-blue-dim);
  }

  @media (max-width: 800px) {
    .top,
    .skills-tools,
    .task-columns,
    .tasks-results {
      grid-template-columns: 1fr;
    }

    .goals {
      max-width: none;
      margin-left: 0;
    }

    .case {
      padding: 26px 22px;
    }

    .tasks h3,
    .results h3,
    .goals .eyebrow {
      font-size: 30px;
      -webkit-text-stroke-width: 2px;
    }

    .stat-value {
      font-size: 32px;
      -webkit-text-stroke-width: 1.5px;
    }
  }
</style>
