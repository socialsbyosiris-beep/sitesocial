---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
  shape?: 'square' | 'circle';
}

const { item, shape = 'square' } = Astro.props;
---

<figure class="card">
  <div class:list={['thumb', item.tone, shape]}>
    {
      item.icon === 'camera' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="3" />
          <path d="M8 7l1.6-3h4.8L16 7" />
          <circle cx="12" cy="14" r="4" />
        </svg>
      )
    }
    {
      item.icon === 'play' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <path d="M10 8.5l6 3.5-6 3.5z" fill="white" stroke="none" />
        </svg>
      )
    }
    {
      item.icon === 'calendar' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="16" rx="3" />
          <path d="M3 10h18M8 3v4M16 3v4" />
        </svg>
      )
    }
    {
      item.icon === 'chat' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 5h16v11H9l-5 4z" />
        </svg>
      )
    }
    {
      item.icon === 'mail' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="5.5" width="19" height="13" rx="3" />
          <path d="M3.5 7l8.5 6 8.5-6" />
        </svg>
      )
    }
    {
      item.icon === 'star' && (
        <svg viewBox="0 0 24 24" fill="white" stroke="none">
          <path d="M12 2.5l2.8 6 6.6.6-5 4.4 1.5 6.5L12 16.7 6.1 20l1.5-6.5-5-4.4 6.6-.6z" />
        </svg>
      )
    }
  </div>
  <figcaption>{item.category}</figcaption>
</figure>

<style>
  .card {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--card);
    box-shadow: 0 10px 26px rgba(70, 115, 144, 0.16);
  }

  .thumb.square {
    border-radius: 30px;
  }

  .thumb.circle {
    border-radius: 50%;
  }

  .thumb svg {
    width: 34%;
    height: 34%;
  }

  .thumb.blue {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
  }

  .thumb.peach {
    background: linear-gradient(135deg, var(--peach), #d99f6c);
  }

  .thumb.sand {
    background: linear-gradient(135deg, #ddc4ae, var(--sand-line));
  }

  .thumb.sage {
    background: linear-gradient(135deg, var(--sage), var(--sage-dark));
  }

  .thumb.rose {
    background: linear-gradient(135deg, var(--rose), var(--rose-dark));
  }

  figcaption {
    font-size: 15px;
    font-weight: 800;
    color: var(--ink);
    text-align: center;
    line-height: 1.3;
  }
</style>
