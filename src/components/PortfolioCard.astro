---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
  shape?: 'square' | 'circle';
}

const { item, shape = 'square' } = Astro.props;
---

<figure class="card">
  <div class:list={['thumb', shape]}>
    <img src={item.image} alt={item.alt} loading="lazy" />
  </div>
  <figcaption>{item.category}</figcaption>
</figure>

<style>
  .card {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 3px solid var(--card);
    box-shadow: 0 10px 26px rgba(70, 115, 144, 0.16);
  }

  .thumb.square {
    border-radius: 30px;
  }

  .thumb.circle {
    border-radius: 50%;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figcaption {
    font-size: 15px;
    font-weight: 800;
    color: var(--ink);
    text-align: center;
    line-height: 1.3;
  }
</style>
