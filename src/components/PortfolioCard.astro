---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;
---

<article class="card">
  <div class:list={['thumb', item.tone]}>
    <span class="monogram">{item.title.charAt(0)}</span>
  </div>
  <div class="body">
    <span class="category">{item.category}</span>
    <h3>{item.title}</h3>
    <p>{item.description}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 2px solid var(--sand-line);
    border-radius: 22px;
    overflow: hidden;
  }

  .thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
  }

  .thumb.blue {
    background: linear-gradient(135deg, var(--blue), var(--blue-dark));
  }

  .thumb.peach {
    background: linear-gradient(135deg, var(--peach), #d99f6c);
  }

  .thumb.sand {
    background: linear-gradient(135deg, var(--sand), var(--sand-line));
  }

  .monogram {
    font-family: var(--display);
    font-size: 44px;
    font-weight: 800;
    color: rgba(255, 253, 251, 0.75);
  }

  .thumb.sand .monogram {
    color: rgba(70, 115, 144, 0.35);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 22px 26px;
  }

  .category {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tint);
  }

  h3 {
    font-family: var(--display);
    font-size: 21px;
    font-weight: 700;
    color: var(--blue);
  }

  p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
