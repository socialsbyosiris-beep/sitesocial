---
import type { Package } from '../data/site';
import { site } from '../data/site';

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(pkg.name + ' package')}`;
---

<article class:list={['card', { featured: pkg.featured }]}>
  {pkg.badge && <span class="badge">{pkg.badge}</span>}

  <div class="head">
    <span class="eyebrow">{pkg.eyebrow}</span>
    <h2>{pkg.name}</h2>
    <p class="blurb">{pkg.blurb}</p>
  </div>

  <div class="price">
    <div class="amount">
      <span class="figure">{pkg.price}</span>
      <span class="per">/mo</span>
    </div>
    <span class="meta">{pkg.meta}</span>
  </div>

  <ul>
    {
      pkg.features.map((feature) => (
        <li>
          <span class="mark">✦</span>
          {feature}
        </li>
      ))
    }
  </ul>

  {pkg.note && <p class="note">{pkg.note}</p>}

  <a class="cta" href={mailto}>{pkg.cta}</a>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: var(--card);
    border: 2px solid var(--sand-line);
    border-radius: 26px;
    padding: 38px 32px 34px;
  }

  .card.featured {
    background: var(--blue);
    border-color: var(--blue);
    padding-top: 46px;
    box-shadow: 0 18px 44px rgba(70, 115, 144, 0.28);
  }

  .badge {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--peach);
    color: var(--peach-ink);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .featured .eyebrow {
    color: var(--on-blue-dim);
  }

  h2 {
    font-family: var(--display);
    font-size: 36px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--blue);
  }

  .featured h2 {
    color: var(--card);
  }

  .blurb {
    margin: 4px 0 0;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--muted);
    min-height: 46px;
  }

  .featured .blurb {
    color: var(--on-blue-soft);
  }

  .price {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 22px;
    border-bottom: 2px dashed var(--dash);
  }

  .featured .price {
    border-bottom-color: rgba(255, 253, 251, 0.35);
  }

  .amount {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .figure {
    font-family: var(--display);
    font-size: 52px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }

  .featured .figure {
    color: var(--card);
  }

  .per {
    font-size: 17px;
    font-weight: 700;
    color: var(--muted-light);
  }

  .meta {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--muted-lighter);
  }

  .featured .per,
  .featured .meta {
    color: var(--on-blue-dim);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  li {
    display: flex;
    gap: 11px;
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .featured li {
    color: var(--on-blue);
  }

  .mark {
    color: var(--tint);
    font-weight: 700;
  }

  .featured .mark {
    color: var(--peach);
  }

  .note {
    margin: -6px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    font-weight: 700;
    color: var(--muted-lighter);
  }

  .cta {
    margin-top: auto;
    padding: 15px 20px;
    border: 2px solid var(--blue);
    border-radius: 999px;
    text-align: center;
    font-size: 16px;
    font-weight: 800;
    color: var(--blue);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .cta:hover {
    background: var(--blue);
    color: var(--cream);
  }

  .featured .cta {
    background: var(--card);
    border-color: var(--card);
    color: var(--blue);
  }

  .featured .cta:hover {
    background: var(--peach);
    border-color: var(--peach);
    color: var(--peach-ink);
  }
</style>
