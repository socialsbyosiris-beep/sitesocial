---
import type { Package } from '../data/site';
import { site } from '../data/site';

interface Props {
  pkg: Package;
  reversed?: boolean;
}

const { pkg, reversed = false } = Astro.props;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(pkg.name + ' package')}`;
const midpoint = Math.ceil(pkg.features.length / 2);
const primaryFeatures = pkg.features.slice(0, midpoint);
const secondaryFeatures = pkg.features.slice(midpoint);
---

<article class:list={['row', pkg.tone, { reversed }]}>
  <div class="price-block">
    <span class="figure">{pkg.price}</span>
    <span class="unit">/mo</span>
  </div>

  <div class="detail">
    {pkg.badge && <span class="badge">{pkg.badge}</span>}

    <div class="head">
      <span class="eyebrow">{pkg.eyebrow}</span>
      <h2>{pkg.name}</h2>
      <p class="blurb">{pkg.blurb}</p>
      <p class="meta">{pkg.meta}</p>
    </div>

    <div class="columns">
      <div class="col">
        <span class="label">What's Included</span>
        <ul>
          {primaryFeatures.map((feature) => (
            <li>
              <span class="mark">✦</span>
              {feature}
            </li>
          ))}
        </ul>
      </div>
      <div class="col">
        <span class="label">Also Included</span>
        <ul>
          {secondaryFeatures.map((feature) => (
            <li>
              <span class="mark">✦</span>
              {feature}
            </li>
          ))}
        </ul>
        {pkg.note && <p class="note">{pkg.note}</p>}
      </div>
    </div>

    <a class="cta" href={mailto}>{pkg.cta}</a>
  </div>
</article>

<style>
  .row {
    position: relative;
    display: flex;
    gap: 28px;
    align-items: stretch;
  }

  .row.reversed {
    flex-direction: row-reverse;
  }

  .price-block {
    flex: 0 0 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .figure {
    font-family: var(--display);
    font-size: 68px;
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .row.peach .figure {
    color: var(--peach-muted);
  }

  .row.blue .figure {
    color: var(--blue);
  }

  .row.ink .figure {
    color: var(--blue-dark);
  }

  .unit {
    font-size: 17px;
    font-weight: 800;
    margin-top: 4px;
  }

  .row.peach .unit {
    color: var(--peach-muted);
  }

  .row.blue .unit {
    color: var(--blue);
  }

  .row.ink .unit {
    color: var(--blue-dark);
  }

  .detail {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: var(--card);
    border: 2px solid var(--sand-line);
    border-radius: 26px;
    padding: 36px 36px 30px;
  }

  .badge {
    position: absolute;
    top: -15px;
    left: 36px;
    background: var(--peach);
    color: var(--peach-ink);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 8px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  h2 {
    font-family: var(--display);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--blue);
  }

  .blurb {
    margin: 2px 0 0;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  .meta {
    margin: 0;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--muted-lighter);
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding-top: 20px;
    border-top: 2px dashed var(--dash);
  }

  .label {
    display: block;
    margin-bottom: 10px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tint);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  li {
    display: flex;
    gap: 9px;
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .mark {
    color: var(--tint);
    font-weight: 700;
    flex-shrink: 0;
  }

  .note {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 700;
    color: var(--muted-lighter);
  }

  .cta {
    align-self: flex-start;
    padding: 14px 28px;
    border: 2px solid var(--blue);
    border-radius: 999px;
    text-align: center;
    font-size: 15.5px;
    font-weight: 800;
    color: var(--blue);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .cta:hover {
    background: var(--blue);
    color: var(--cream);
  }

  @media (max-width: 800px) {
    .row,
    .row.reversed {
      flex-direction: column;
    }

    .price-block {
      flex: none;
      width: 100%;
      flex-direction: row;
      justify-content: center;
      gap: 8px;
      padding: 22px;
    }

    .figure {
      font-size: 50px;
    }

    .columns {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
