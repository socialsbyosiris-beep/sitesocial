---
import { site } from '../data/site';

interface Props {
  heading?: string;
  blurb?: string;
}

const {
  heading = 'Not sure which fits?',
  blurb = "Tell me about your business and I'll point you to the right package.",
} = Astro.props;
---

<section class="cta">
  <div class="copy">
    <h2>{heading}</h2>
    <p>{blurb}</p>
  </div>
  <a class="email-btn" href={`mailto:${site.email}`}>Email Me</a>
</section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
    justify-content: space-between;
    background: var(--card);
    border: 2px solid var(--sand-line);
    border-radius: 26px;
    padding: 46px 40px;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h2 {
    font-family: var(--display);
    font-size: 34px;
    font-weight: 700;
    color: var(--blue);
  }

  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--muted);
  }

  .email-btn {
    flex-shrink: 0;
    padding: 16px 32px;
    border: 2px solid var(--blue);
    border-radius: 999px;
    font-size: 17px;
    font-weight: 800;
    color: var(--blue);
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .email-btn:hover {
    background: var(--blue);
    color: var(--cream);
  }
</style>
